#!/usr/bin/env bash
# Generated by claude-kit. Restates the project's Key Rules after a compaction,
# since that is exactly when they fall out of context.
#
# The loop-critical lines are the last two. A compact is the single event a
# bounded loop cannot survive on its own: the attempt counter lives in the
# model's context and silently resets to a fresh 3, which is precisely the
# runaway the cap exists to prevent. This is the reminder that it is on disk.
set -euo pipefail

cat <<'EOF'
Reminder — <% project.name %> key rules:

<% each rules.all %>- <% . %>
<% end %>
- To verify ANY change run: .claude/scripts/verify.sh <quick|tests|full|integration>
  Never run the underlying build/lint/test commands by hand — only its VERDICT
  block is authoritative, and a FAIL is a stop, not a suggestion
- Never stage or commit <% project.plans_dir %>/** or <% project.qa_dir %>/** — they are
  working artifacts, deliberately not git-ignored
- Never run destructive git (checkout/restore/stash/clean/reset --hard) — the
  tree carries work that exists nowhere else
- The full rule list is .claude/skills/shared/safety-invariants.md
- Mid-loop? Your attempt counters are in <% project.plans_dir %>/<ID>.state.json, not in
  this context — read them back rather than restarting the count:
  .claude/scripts/plan-state.sh <ID> show
EOF

exit 0
