#!/usr/bin/env bash
# Generated by claude-kit. Blocks hand-edits to generated migration files.
# Wired as PreToolUse on Edit|Write: migrations come from the ORM's own CLI, so a
# Write into the migrations folder is a hand-authored migration too.
set -euo pipefail

INPUT=$(cat)
FILE_PATH=$(printf '%s' "$INPUT" | jq -r '.tool_input.file_path // empty')

[ -z "$FILE_PATH" ] && exit 0

<% each hook.rules %>
if [[ "$FILE_PATH" == *"<% .path_contains %>"* <% if .has_ext %>&& "$FILE_PATH" == *.<% .ext %> <% end %>]]; then
  echo "<% .message %>" >&2
  exit 2
fi
<% end %>
exit 0
